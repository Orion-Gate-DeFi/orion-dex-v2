# Security headers for the Orion DEX static frontend — Caddy variant.
#
# Why this exists: index.html carries a <meta http-equiv> CSP, but browsers
# IGNORE `frame-ancestors` (and X-Frame-Options) delivered via <meta> — the
# app stays frameable (clickjacking) until these arrive as real HTTP headers
# from the hosting layer (audit 2026-06-11).
#
# Usage: import this file inside the site block that serves
# dist/orion-app/browser/, e.g.
#
#   app.oriongate.services {
#       root * /srv/orion-app/browser
#       try_files {path} /index.html
#       file_server
#       import /etc/caddy/orion-headers.caddy
#   }
#
# KEEP THE CSP IN SYNC with orion-app/src/index.html — when both a header
# and a <meta> CSP are present, browsers enforce the intersection, so a
# stale copy here silently breaks the app.

header {
	# Mirror of the index.html <meta> CSP (single line, as required by the
	# header), incl. frame-ancestors 'none' — effective only from here.
	Content-Security-Policy "default-src 'self'; script-src 'self' https://auth.privy.io https://verify.walletconnect.com https://*.walletconnect.org https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' https://api.oriongate.services https://api.gopluslabs.io https://api.dexscreener.com https://auth.privy.io https://*.privy.io https://rpc.privy.systems https://*.rpc.privy.systems https://*.walletconnect.com https://*.walletconnect.org wss://*.walletconnect.com wss://*.walletconnect.org https://*.eth.link https://mainnet.base.org https://*.drpc.org https://base.drpc.org https://rpc.ankr.com https://*.llamarpc.com https://eth.llamarpc.com https://base.llamarpc.com https://polygon.llamarpc.com https://arbitrum.llamarpc.com https://optimism.llamarpc.com https://arb1.arbitrum.io https://polygon-rpc.com https://mainnet.optimism.io https://cloudflare-eth.com https://*.publicnode.com https://gasstation.polygon.technology https://*.polygon.technology https://*.oriongate.services https://li.quest https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io; frame-src 'self' https://auth.privy.io https://verify.walletconnect.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

	# Legacy clickjacking protection for browsers that predate
	# frame-ancestors; harmless redundancy everywhere else.
	X-Frame-Options "DENY"

	X-Content-Type-Options "nosniff"
	Referrer-Policy "strict-origin-when-cross-origin"

	# 1 year. Add `; preload` only after submitting the domain to
	# hstspreload.org — preload is effectively irreversible.
	Strict-Transport-Security "max-age=31536000; includeSubDomains"
}
